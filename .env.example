# Copy to .env beside the Compose file and edit before deployment.
# Leave the setup-managed values below empty for first-run setup at http://server:8787/setup.
# Existing deployments may keep environment values; non-empty environment values
# take precedence over /data/config.json and cannot be edited in the setup UI.
# API_TOKEN is the administrator account key, not a Hub/GitHub token.
# Create regular account keys in Web Settings; each user's clients use their own key.
# PowerShell: [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
# Linux/macOS: openssl rand -hex 32
API_TOKEN=
ADMIN_WEB_ORIGINS=
# Optional actual browser URL of the Web console, e.g. http://nas:8081.
# Keep empty to configure it in /setup. This is separate from the CORS allowlist.
ADMIN_WEB_URL=
# Allow authenticated inventory writes from the web console when set to true.
WEB_INVENTORY_ENABLED=
# Optional path overrides. Keep empty to save config/logs beside the mounted DB.
CONFIG_PATH=
LOG_DIR=
# Source build only. The published Web image is already built and ignores this value.
# Empty uses the web page host with API port 8787 when building admin-web locally.
VITE_DEFAULT_API_BASE_URL=
# Hub Compose channel: latest = stable, dev = development (dev/web-dev).
# Run the channel switch assistant instead of editing image tags manually.
COMPONENT_VAULT_DOCKER_CHANNEL=latest
# Optional complete image overrides. Leave BOTH empty to use the channel above.
# Existing non-empty overrides retain priority; keep API and Web on the same version.
COMPONENT_VAULT_IMAGE=
COMPONENT_VAULT_WEB_IMAGE=

# Advanced optional server integration settings. Leave blank/default unless used.
LCSC_OPENAPI_KEY=
LCSC_OPENAPI_SECRET=
LCSC_OPENAPI_BASE_URL=https://ips.lcsc.com
LCSC_LOOKUP_CACHE_TTL_SECONDS=43200
IMPORT_RULES_REMOTE_URL=
IMPORT_RULES_REFRESH_HOURS=24
ENABLE_WEB_FALLBACK_RESOLVERS=false

# Advanced optional MQTT defaults. The authenticated Web settings page can save
# MQTT configuration in SQLite; saved values take precedence after API restart.
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=component-vault
MQTT_CLIENT_ID=component-vault-server
