<Window
    x:Class="ComponentVault.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ComponentVault.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </Grid.Resources>
        <NavigationView
            x:Name="AppNavigationView"
            IsBackButtonVisible="Auto"
            IsBackEnabled="False"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="True"
            OpenPaneLength="224"
            CompactPaneLength="48"
            PaneDisplayMode="Auto">
            <NavigationView.Header>
                <Grid Margin="0,0,16,8" MinHeight="48" ColumnSpacing="12" RowSpacing="8">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="CompactHeader">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="ShellSyncSummaryText.(Grid.Row)" Value="1" />
                                    <Setter Target="ShellSyncSummaryText.(Grid.Column)" Value="0" />
                                    <Setter Target="ShellSyncSummaryText.(Grid.ColumnSpan)" Value="3" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="ExpandedHeader">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="1000" />
                                </VisualState.StateTriggers>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE719;" FontSize="18" Foreground="{StaticResource VaultAccentBrush}" />
                        <StackPanel Spacing="0">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Component Vault" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="本地优先库存" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock
                        x:Name="ShellSyncSummaryText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="Normal"
                        TextWrapping="Wrap"
                        TextTrimming="None"
                        Foreground="{StaticResource TextFillColorSecondaryBrush}"
                        Text="{Binding ShellSyncSummary}" />
                    <Button
                        x:Name="SyncNowButton"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Normal"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnSyncNowClicked"
                        IsEnabled="{Binding CanRunSyncActions}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <FontIcon
                                    Glyph="&#xE895;"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Visibility="{Binding CanRunSyncActions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    Foreground="{Binding Foreground, ElementName=SyncNowButton}"
                                    IsActive="{Binding IsBusy}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                            <TextBlock VerticalAlignment="Center" Text="{Binding SyncButtonLabel}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </NavigationView.Header>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="OverviewItem" x:Uid="MainWindowOverviewItem" Content="首页" Tag="Overview">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="InventoryItem" x:Uid="MainWindowInventoryItem" Content="库存" Tag="Inventory">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="MovementsItem" x:Uid="MainWindowMovementsItem" Content="记录" Tag="Movements">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Sort" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="BomItem" Content="项目 BOM" Tag="Bom">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="OpenFile" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="KittingItem" Content="配套件" Tag="Kitting"><NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsItem" x:Uid="MainWindowSettingsItem" Content="设置" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="RootFrame" />
        </NavigationView>
    </Grid>
</Window>
