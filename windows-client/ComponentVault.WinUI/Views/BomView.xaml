<Page
    x:Class="ComponentVault.WinUI.Views.BomView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        Padding="24"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Spacing="4">
                <TextBlock
                    Style="{StaticResource PageTitleTextStyle}"
                    Text="项目用料" />
                <TextBlock
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Text="导入 BOM、加载已保存预设或手动选料，统一核对用量和库位后确认出库。" />
            </StackPanel>
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="OnNewBatchClicked"
                Content="新建批次" />
        </Grid>
        <Border
            Grid.Row="1"
            Style="{StaticResource CardBorderStyle}">
            <Grid
                ColumnSpacing="16"
                RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="2*" />
                    <ColumnDefinition
                        Width="140" />
                    <ColumnDefinition
                        Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Border
                        Width="24"
                        Height="24"
                        CornerRadius="12"
                        Background="{StaticResource VaultAccentBrush}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="1" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="项目与用料来源" />
                    <Button Click="OnManualStartClicked" Content="手动选料" />
                </StackPanel>
                <TextBox
                    x:Name="ProjectNameBox"
                    Grid.Row="1"
                    Header="项目名称"
                    PlaceholderText="例如：主控板 A"
                    TextChanged="OnInputsChanged" />
                <NumberBox
                    x:Name="BatchQuantityBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    Header="套数"
                    Minimum="1"
                    Value="1"
                    SpinButtonPlacementMode="Compact"
                    ValueChanged="OnBatchQuantityChanged" />
                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    MinWidth="132"
                    VerticalAlignment="Bottom"
                    Click="OnChooseFileClicked"
                    Content="导入 BOM"
                    Style="{StaticResource AccentButtonStyle}" />
                <Expander
                    x:Name="MappingExpander"
                    Grid.Row="2"
                    Grid.ColumnSpan="3"
                    Header="列识别与手动调整"
                    IsEnabled="False"
                    IsExpanded="False">
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="MappingSummaryText"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="MappingButton"
                            HorizontalAlignment="Left"
                            Click="OnMappingClicked"
                            Content="调整列映射" />
                    </StackPanel>
                </Expander>
                <StackPanel
                    Grid.Row="3"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ComboBox
                        x:Name="PresetBox"
                        MinWidth="240"
                        PlaceholderText="已保存预设"
                        SelectionChanged="OnPresetSelectionChanged" />
                    <Button
                        x:Name="LoadPresetButton"
                        Click="OnLoadPresetClicked"
                        Content="加载预设"
                        IsEnabled="False" />
                    <Button
                        x:Name="DeletePresetButton"
                        Click="OnDeletePresetClicked"
                        Content="删除预设"
                        IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>
        <Border
            Grid.Row="2"
            Style="{StaticResource CardBorderStyle}">
            <Grid
                RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                </Grid.RowDefinitions>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Border
                        Width="24"
                        Height="24"
                        CornerRadius="12"
                        Background="{StaticResource VaultAccentBrush}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="2" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="预览与匹配" />
                </StackPanel>
                <TextBlock
                    x:Name="SummaryText"
                    Grid.Row="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="请选择导入 BOM、已保存预设或手动选料开始。"
                    TextWrapping="Wrap" />
                <CommandBar
                    Grid.Row="2"
                    HorizontalContentAlignment="Left"
                    DefaultLabelPosition="Right">
                    <AppBarButton x:Name="AddMaterialButton" Click="OnAddMaterialClicked" Label="添加用料" Icon="Add" IsEnabled="False" />
                    <AppBarButton x:Name="EditQuantityButton" Click="OnEditQuantityClicked" Label="修改每套用量" Icon="Edit" IsEnabled="False" />
                    <CommandBar.SecondaryCommands>
                    <AppBarButton x:Name="SourceRowButton" Click="OnSourceRowClicked" Label="查看来源" IsEnabled="False" />
                    <AppBarButton
                        x:Name="ResolveButton"
                        Click="OnResolveClicked"
                        Label="为选中行选择库存"
                        IsEnabled="False" />
                    <AppBarButton
                        x:Name="SkipButton"
                        Click="OnSkipClicked"
                        Label="跳过选中行"
                        IsEnabled="False" />
                    <AppBarButton
                        x:Name="RestoreButton"
                        Click="OnRestoreClicked"
                        Label="恢复选中行"
                        IsEnabled="False"
                        Visibility="Collapsed" />
                    </CommandBar.SecondaryCommands>
                </CommandBar>
                <ListView
                    x:Name="PreviewList"
                    Grid.Row="3"
                    SelectionMode="Single"
                    SelectionChanged="OnPreviewSelectionChanged" />
            </Grid>
        </Border>
        <Grid
            Grid.Row="3"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <Border
                    Width="24"
                    Height="24"
                    CornerRadius="12"
                    Background="{StaticResource VaultAccentBrush}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Text="3" />
                </Border>
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="确认出库" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" MaxHeight="130" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="PlanText" TextWrapping="Wrap" /></ScrollViewer>
            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="ExportButton"
                        Click="OnExportClicked"
                        Content="导出缺料 CSV"
                        IsEnabled="False" />
                    <Button
                        x:Name="SavePresetButton"
                        Click="OnSavePresetClicked"
                        Content="保存为预设"
                        IsEnabled="False" />
                </StackPanel>
                <Button
                    x:Name="ConfirmButton"
                    Grid.Column="1"
                    Click="OnConfirmClicked"
                    Content="确认并扣减库存"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
